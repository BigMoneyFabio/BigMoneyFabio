   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fd1eae9e",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu = 0\n",
    "sigma = 1\n",
    "B = 1000"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "42c01ffb",
   "metadata": {},
   "outputs": [],
   "source": [
    "MC_Sim = np.random.normal(mu, sigma, B)\n",
    "plt.hist(MC_Sim, bins=30, density=True)\n",
    "plt.title('Monte Carlo Simulation of Normal Distribution')"
   ]
  }
